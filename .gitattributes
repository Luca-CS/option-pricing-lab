# Scripts that run in WSL or in a Linux container from this Windows checkout (/mnt/c) need LF line endings, whatever
# core.autocrlf says: with CRLF, sh reads 'set -eu\r' and stops.
*.sh text eol=lf
deploy/Caddyfile text eol=lf
# The front's sources keep LF in every checkout: Biome checks the line endings, and CI runs on Linux.
frontend/** text eol=lf
frontend/public/*.png binary
frontend/**/*.woff2 binary
