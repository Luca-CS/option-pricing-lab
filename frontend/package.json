{
  "name": "optlab-frontend",
  "private": true,
  "description": "The desk's front (session 2): one application on API v1, served by the API on the same origin.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "generate": "openapi-typescript ../api/openapi.json --default-non-nullable false -o src/api/schema.d.ts",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/modals": "9.8.0",
    "@mantine/notifications": "9.8.0",
    "@mantine/spotlight": "9.8.0",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "8.21.3",
    "echarts": "6.1.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
