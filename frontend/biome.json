{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": [
      "**",
      "!src/api/schema.d.ts",
      "!dist",
      "!dist-demo",
      "!demo/recorded",
      "!test-results",
      "!playwright-report",
      "!playwright-report-demo"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@mantine/core": {
                "importNames": ["AppShell", "SimpleGrid", "Grid", "Flex", "ColorSchemeScript", "InlineStyles"],
                "message": "These write <style> elements at run time, which the page CSP refuses (ADR-0024): lay out with CSS."
              }
            }
          }
        }
      },
      "security": { "noDangerouslySetInnerHtml": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
